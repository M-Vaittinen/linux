/dts-v1/;
/plugin/;

/{ /* this is our device tree overlay root node */

	compatible = "ti,beaglebone", "ti,beaglebone-black";
	part-number = "BBB-I2C1"; // you can choose any name here but it should be memorable
 	version = "00A0";

	fragment@1 {
		target-path = "/";
		__overlay__ {
			/* external oscillator */
			osc: oscillator {
				compatible = "fixed-clock";
				#clock-cells = <1>;
				clock-frequency  = <32768>;
				clock-output-names = "osc";
			};

			testbattery: battery {
				compatible = "simple-battery";
				/* I just pulled these values from my hat :) */
				ocv-capacity-celsius = <25>;
				ocv-capacity-table-0 = <4200000 100
							4184314 100
							4140723 95
							4099487 90
							4060656 85
							4024350 80
							3991121 75
							3954379 70
							3913265 65
							3877821 60
							3855577 55
							3837466 50
							3822194 45
							3809012 40
							3795984 35
							3780647 30
							3760505 25
							3741532 20
							3718837 15
							3696698 10
							3690594 5
							3581427 0
							3110433 (-5)>;

				rohm,volt-drop-soc = <1000 1000 950 900 850
					800 750 700 650 600 550 500 450 400 350
					300 250 200 150 100 50 00 (-50)>;

				rohm,volt-drop-high-temp-microvolt =  <100 100
					102 104 106 109 114 124 117 107 107 109
					112 116 117 108 109 109 108 109 122 126
					130>;

				rohm,volt-drop-normal-temp-microvolt = <100 100
					102 105 98 100 105 102 101 99 98 100
					103 105 109 117 111 109 110 114 128 141
					154>;

				rohm,volt-drop-low-temp-microvolt = <100 100 98
					107 112 114 118 118 112 108 108 110 111
					113 117 123 131 144 157 181 220 283
					399>;

				rohm,volt-drop-very-low-temp-microvolt = <86 86
					105 109 114 110 115 115 110 108 110 112
					114 118 124 134 136 160 177 201 241 322
					403>;

				/* charge-full-design-microamp-hours = <3000000>; */
				charge-full-design-microamp-hours = <1799000>;
				voltage-max-design-microvolt = <4200000>;
				voltage-min-design-microvolt = <3500000>;
				rohm,voltage-vdr-thresh-microvolt = <4150000>;
				degrade-cycle-microamp-hours = <131>;
				/*
				degrade-cycle-microamp-hours <2>;
				temp-degrade-table = <
				*/
			};
		};
	};

	fragment@2 {
		target = <&i2c2>;

		__overlay__ {
			pinctrl-0 = <&i2c2_pins>;
			clock-frequency = <100000>;
			status = "okay";


			bdpmic: bd72720@4b {
				compatible = "rohm,bd72720";
				reg = <0x4b>;
				interrupt-parent = <&gpio1>;
//				/* GPIO 1_29 - (connector 8, pin 26) for irq */
/*				interrupts = <29 GPIO_ACTIVE_LOW>; */
				interrupts = <29 8>;
				clocks = <&osc 0>;
				#clock-cells = <0>;
				clock-output-names = "bd72720-32k-out";
				rohm,clkout-open-drain = <0>;
				#gpio-cells = <2>;
				gpio-controller;
				/* With default OTP the GPIO 1 is used for DVS0
				   input (not usable as GPO) and GPIO 3 is used
				   for DVS1 input. GPIO 2 can be used for GPO
				   and is by default connected to EPDEN. Let's
				   exclude GPIO 1 and 3 from use */
/*				ngpios = <4>; */
				rohm,pin-exten0 = "gpo";
				rohm,pin-dvs0 = "gpi";

/*				gpio-reserved-ranges = <0 1>, <2 1>; */
				rohm,dvs-vsel-gpios = <&gpio1 12 0>,
						      <&gpio1 13 0>;
				/* 30 milli Ohm RSENS resistor */ 
				rohm,charger-sense-resistor-milli-ohms = <30>;
				monitored-battery = <&testbattery>;

				regulators {
					buck1 {
						regulator-name = "buck1";

/*
 * Vol regs:
 * Deep Idle	0x22
 * IDLE		0x23
 * SUSP		0x24
 * RUN		0x25
 * RUN0 .. RUN3	0x36 .. 0x29
 *
 * vals:
 * 0x0 .. 0xc0 500mV + (sel * 6.25 mV)
 * 0xc1 .. 0xff 1.7 V
 */


						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <2000000>;
						/* Ramp reg 0x21, bit[7:6] val 0x2 */
						regulator-ramp-delay = <10000>;
						rohm,dvs-run-voltage = <500000>;
						rohm,dvs-idle-voltage = <506250>;
						/* Try disable at susp. reg 0x20, bit [2] cleared */
						rohm,dvs-suspend-voltage = <0>;
						rohm,dvs-lpsr-voltage = <1700000>;
						regulator-boot-on;
					};
					buck2 {
						/* vreg 0x2c ... 0x2f. RUN 0x2f, no sub run */
						regulator-name = "buck2";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <2000000>;
						/* Ramp reg 0x2b, bit[7:6] val 0x2 */
						regulator-ramp-delay = <10000>;
						rohm,dvs-run-voltage = <500000>;
						rohm,dvs-idle-voltage = <506250>;
						rohm,dvs-suspend-voltage = <1700000>;
						/* EN reg 0x2a, lpsr bit[0] */
						rohm,dvs-lpsr-voltage = <0>;
						regulator-boot-on;
					};
					buck3 {
						/* vreg 0x32 ... 0x35. RUN 0x35, no sub run */
						regulator-name = "buck3";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <2000000>;

						rohm,dvs-run-voltage = <1700000>;
						/* 0x30, bit [1] */
						rohm,dvs-idle-voltage = <0>;
						rohm,dvs-suspend-voltage = <512500>;
						rohm,dvs-lpsr-voltage = <518750>;
						regulator-boot-on;
					};
					buck4 {
						regulator-name = "buck4";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <1800000>;

						/* 0x3b */
						rohm,dvs-run-voltage = <500000>;
						/* 0x39 */
						rohm,dvs-idle-voltage = <1700000>;
						rohm,dvs-suspend-voltage = <512500>;
						/* 0x36, bit [0] */
						rohm,dvs-lpsr-voltage = <0>;
						regulator-boot-on;
					};
					buck5 {
						regulator-name = "buck5";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <3300000>;
						/* 0x3e */
						rohm,dvs-run-voltage = <500000>;
						rohm,dvs-idle-voltage = <1>;
						rohm,dvs-suspend-voltage = <1>;
						/* 0x3c, bit [0] */
						rohm,dvs-lpsr-voltage = <0>;
						regulator-boot-on;
					};
					buck6 {
						regulator-name = "buck6";
						regulator-min-microvolt = <1500000>;
						regulator-max-microvolt = <3300000>;
						regulator-ramp-delay = <10000>;
						/* 0x41 */
						/* vsel 0x00 .. 0xB4 1.5V + (sel * 10mV)
						        0xb5 .. 0xff 3.3 V
						*/
						rohm,dvs-run-voltage = <1500000>;
						rohm,dvs-idle-voltage = <1>;
						rohm,dvs-suspend-voltage = <1>;
						/* 0x3f, bit [0] */
						rohm,dvs-lpsr-voltage = <0>;
						/*
						rohm,dvs-runlevel-microvolts =
								<500000>,
								<506250>,
								<512500>,
								<518750>;
								*/
						regulator-boot-on;
					};
					buck7 {
						regulator-name = "buck7";
						regulator-min-microvolt = <1500000>;
						regulator-max-microvolt = <3300000>;
						regulator-ramp-delay = <2500>;
						/* 0x44 */
						/* vsel 0x00 .. 0xB4 1.5V + (sel * 10mV)
						        0xb5 .. 0xff 3.3 V
						*/
						rohm,dvs-run-voltage = <1500000>;
						rohm,dvs-idle-voltage = <1>;
						rohm,dvs-suspend-voltage = <1>;
						/* 0x42, bit [0] */
						rohm,dvs-lpsr-voltage = <0>;
						regulator-boot-on;
					};
					buck8 {
						regulator-name = "buck8";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <1700000>;
						regulator-ramp-delay = <2500>;
						/* 0x47 */
						/* vsel 0x00 .. 0x78 0.5V + (sel * 10mV)
						        0x79 .. 0xff 1.7 V
						*/
						rohm,dvs-run-voltage = <1700000>;
						rohm,dvs-idle-voltage = <1>;
						rohm,dvs-suspend-voltage = <1>;
						/* 0x45, bit [0] */
						rohm,dvs-lpsr-voltage = <0>;
						regulator-boot-on;
					};
					buck9 {
						regulator-name = "buck9";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <1700000>;
						regulator-ramp-delay = <2500>;
						/* 0x4a */
						/* vsel 0x00 .. 0x78 0.5V + (sel * 10mV)
						        0x79 .. 0xff 1.7 V
						*/
						rohm,dvs-run-voltage = <1700000>;
						rohm,dvs-idle-voltage = <1>;
						rohm,dvs-suspend-voltage = <1>;
						/* 0x4b, bit [0] */
						rohm,dvs-lpsr-voltage = <0>;
						regulator-boot-on;
					};
					buck10 {
						regulator-name = "buck10";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <1700000>;
						regulator-ramp-delay = <2500>;
						/*
						 * NOTE, when LDON_HEAD is set, the BUCK10 should not be
						 * controllable but supplies LDOs 1- 4 and follows LDO setting
						 * with configured offset.
						 */
						/* Uncomment to use LDON_HEAD mode, 150 millivolt offset: */
						/* LDON_HEAD is reg 0x50, bits[2:0] */
						/* rohm,ldon-head-mllivolt = 150; */
						 
						/* 0x4d */
						/* vsel 0x00 .. 0xc0 0.5V + (sel * 6.25mV)
						        0xc1 .. 0xff 1.7 V
						*/
						rohm,dvs-run-voltage = <1700000>;
						rohm,dvs-idle-voltage = <1>;
						rohm,dvs-suspend-voltage = <1>;
						/* 0x4b, bit [0] */
						rohm,dvs-lpsr-voltage = <0>;
						regulator-boot-on;
					};

					ldo1 {
						/* 0x00 to 0x50 = 0.5 V + (sel * 6.25 mV)
						  0x51 .. 0x7F 1.0 V */
						regulator-name = "ldo1";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <1000000>;
						/* ON reg: 0x4e */
						rohm,dvs-suspend-voltage = <0>;
						/* 0x51 */
						rohm,dvs-lpsr-voltage = <500000>;
						/* 0x52 */
						rohm,dvs-idle-voltage = <1000000>;
						/* LDO1 supports sub-run states */
						/* 0x55 .. 0x58 */
						rohm,dvs-runlevel-microvolts =
								<500000>,
								<506250>,
								<512500>,
								<518750>;
						regulator-boot-on;
					};
					ldo2 {
						/* 0x00 to 0x50 = 0.5 V + (sel * 6.25 mV)
						  0x51 .. 0x7F 1.0 V */
						regulator-name = "ldo2";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <1000000>;
						/* ON reg: 0x59, susb[2] */
						rohm,dvs-suspend-voltage = <0>;
						/* 0x5B */
						rohm,dvs-lpsr-voltage = <500000>;
						/* 0x5C */
						rohm,dvs-idle-voltage = <1000000>;
						/* 0x5E */
						rohm,dvs-run-voltage = <750000>;
					};
					ldo3 {
						/* 0x00 to 0x50 = 0.5 V + (sel * 6.25 mV)
						  0x51 .. 0x7F 1.0 V */
						regulator-name = "ldo3";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <1000000>;
						/* ON reg: 0x5f, susb[2] */
						rohm,dvs-suspend-voltage = <0>;
						/* 0x61 */
						rohm,dvs-lpsr-voltage = <500000>;
						/* 0x62 */
						rohm,dvs-idle-voltage = <1000000>;
						/* 0x64 */
						rohm,dvs-run-voltage = <750000>;
					};
					ldo4 {
						/* 0x00 to 0x50 = 0.5 V + (sel * 6.25 mV)
						  0x51 .. 0x7F 1.0 V */
						regulator-name = "ldo4";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <1000000>;
						/* ON reg: 0x65, susb[2] */
						rohm,dvs-suspend-voltage = <0>;
						/* 0x67 */
						rohm,dvs-lpsr-voltage = <500000>;
						/* 0x68 */
						rohm,dvs-idle-voltage = <1000000>;
						/* 0x6A */
						rohm,dvs-run-voltage = <750000>;
					};
					ldo5 {
						/* 0x00 to 0xff = 0.75 V + (sel * 10 mV) max 3.3 V */
						regulator-name = "ldo5";
						regulator-min-microvolt = <750000>;
						regulator-max-microvolt = <3300000>;
						/* ON reg: 0x6B, susb[2] */
						rohm,dvs-suspend-voltage = <0>;
						/* ON reg: 0x6B, lpsr (deep idle) [0] */
						rohm,dvs-lpsr-voltage = <1>;
						/* VID reg 0x6D */
						rohm,dvs-run-voltage = <750000>;
						regulator-boot-on;
					};
					ldo6 {
						/* 0x00 to 0x78 = 0.6 V + (sel * 10 mV) max 1.8 V
						   0x79 .. 0x7f 1.8 V */
						regulator-name = "ldo6";
						regulator-min-microvolt = <600000>;
						regulator-max-microvolt = <1800000>;
						/* ON reg: 0x6E, susb[2] */
						rohm,dvs-suspend-voltage = <0>;
						/* ON reg: 0x6E, lpsr (deep idle) [0] */
						rohm,dvs-lpsr-voltage = <1>;
						/* VID reg 0x70 */
						rohm,dvs-run-voltage = <750000>;
					};
					ldo7_reg: ldo7 {
						/* 0x00 to 0xff = 0.75 V + (sel * 10 mV) max 3.3 V */
						regulator-name = "ldo7";
						regulator-min-microvolt = <750000>;
						regulator-max-microvolt = <3300000>;
						/* ON reg: 0x71, susb[2] */
						rohm,dvs-suspend-voltage = <0>;
						/* ON reg: 0x71, lpsr (deep idle) [0] */
						rohm,dvs-lpsr-voltage = <1>;
						/* VID reg 0x73 */
						rohm,dvs-run-voltage = <750000>;
					};
					ldo8_reg: ldo8 {
						/* 0x00 to 0xff = 0.75 V + (sel * 10 mV) max 3.3 V */
						regulator-name = "ldo8";
						regulator-min-microvolt = <750000>;
						regulator-max-microvolt = <3300000>;
						/* ON reg: 0x74, susb[2] */
						rohm,dvs-suspend-voltage = <0>;
						/* ON reg: 0x74, lpsr (deep idle) [0] */
						rohm,dvs-lpsr-voltage = <1>;
						/* VID reg 0x76 */
						rohm,dvs-run-voltage = <750000>;
					};
					ldo9_reg: ldo9 {
						/* 0x00 to 0xff = 0.75 V + (sel * 10 mV) max 3.3 V */
						regulator-name = "ldo9";
						regulator-min-microvolt = <750000>;
						regulator-max-microvolt = <3300000>;
						/* ON reg: 0x77, susb[2] */
						rohm,dvs-suspend-voltage = <0>;
						/* ON reg: 0x77, lpsr (deep idle) [0] */
						rohm,dvs-lpsr-voltage = <1>;
						/* VID reg 0x79 */
						rohm,dvs-run-voltage = <750000>;
					};
					ldo10_reg: ldo10 {
						/* 0x00 to 0xff = 0.75 V + (sel * 10 mV) max 3.3 V */
						regulator-name = "ldo10";
						regulator-min-microvolt = <750000>;
						regulator-max-microvolt = <3300000>;
						/* ON reg: 0x7a, susb[2] */
						rohm,dvs-suspend-voltage = <0>;
						/* ON reg: 0x7a, lpsr (deep idle) [0] */
						rohm,dvs-lpsr-voltage = <1>;
						/* VID reg 0x7c */
						rohm,dvs-run-voltage = <750000>;
					};
					ldo11_reg: ldo11 {
						/* 0x00 to 0xff = 0.75 V + (sel * 10 mV) max 3.3 V */
						regulator-name = "ldo11";
						regulator-min-microvolt = <750000>;
						regulator-max-microvolt = <3300000>;
						/* ON reg: 0x7d, susb[2] */
						rohm,dvs-suspend-voltage = <0>;
						/* ON reg: 0x7d, lpsr (deep idle) [0] */
						rohm,dvs-lpsr-voltage = <1>;
						/* VID reg 0x7f */
						rohm,dvs-run-voltage = <750000>;
					};
				};
				leds {
					compatible = "rohm,bd72720-leds";
					led-1 {
						rohm,led-compatible = "bd72720-grnled";
						function = "indicator";
						color = <2>;
					};
					led-2 {
						rohm,led-compatible = "bd72720-ambled";
						function = "charging";
						color = <4>;
					};
				};
			};
		};
	};

	fragment@3 {
		target-path = "/";
		__overlay__ {
			clktest: dummy {
				compatible = "rohm,clktest-bd72720";
				clocks = <&bdpmic>;
				clock-names = "foo-in";
			};
			gpiotest: gpouser {
				compatible = "rohm,foo-bd72720-gpio";
				my-gpios = <&bdpmic 1 1>;
			};
		};
	};
}; /* root node end */
