enet_icss1.rxDmaChannel[0].useDefaultFlow = true;

enet_icss2.$name                          = "CONFIG_ENET_ICSS1";
enet_icss2.mode                           = "DUAL MAC";
enet_icss2.phyToMacInterfaceMode          = "RGMII";
enet_icss2.dualMacPortSelected            = "ENET_MAC_PORT_2";
